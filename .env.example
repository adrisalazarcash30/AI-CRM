# Supabase — used by server components and API routes
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key

# Optional but recommended: service role key for server writes (bypasses RLS).
# Leave blank to fall back to the anon key (works only if RLS is disabled on the demo DB).
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key — used by all AI features.
# Leave blank to fall back to local heuristic stubs (demo-safe).
ANTHROPIC_API_KEY=

# Optional Slack incoming webhook for stage-change notifications.
SLACK_WEBHOOK_URL=
